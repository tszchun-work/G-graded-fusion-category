class FoldCoupling:
    """S_AB = (U(sigma)/sqrt2) from B to A at one momentum (the fold of the 1/psi blocks).

    apply() uses the Walsh-Hadamard structure of SymmetryBasis.fold_structure();
    matrix() builds the explicit sparse matrix from the independent transition
    list sigma_transitions() (lazily: explicit blocks, dense solves, validation).
    """

    def __init__(self, basis: SymmetryBasis, m: int, comp, in_a, in_b, loc_a, loc_b,
                 table, dtype):
        L = basis.L
        self.shape = (int(in_a.sum()), int(in_b.sum()))
        self.dtype = dtype
        self._basis, self._m, self._table = basis, m, table
        self._masks = (comp, in_a, in_b, loc_a, loc_b)
        self._matrix = None
        groups, small = basis.fold_structure()
        self.groups = []
        column_counts = np.zeros(self.shape[1], dtype=np.int64)
        work = 0
        for grp in groups:
            src, rows = loc_b[grp["b_reps"]], loc_a[grp["out_reps"]]
            if np.any(src < 0) or np.any(rows < 0):
                raise RuntimeError("U(sigma) does not map the fold's B necklaces into A")
            factor = 2.0 ** ((1 - grp["n"]) / 2.0) * table[(m * grp["out_t"]) % L]
            self.groups.append((grp["count"], grp["half"], src, grp["scatter"], rows,
                                factor.astype(dtype)))
            column_counts[src] += grp["half"]
            work += grp["count"] * grp["half"] * max(grp["n"] + 1, 2)
        self.sparse = self._sparse_part(small, dtype)
        column_counts += np.bincount(self.sparse.indices, minlength=self.shape[1])
        self.column_counts = column_counts            # nonzeros per column of S_AB
        self.cost = work + self.sparse.nnz            # rough flop count of apply()

    def _sparse_part(self, transitions, dtype) -> csr_matrix:
        comp, in_a, in_b, loc_a, loc_b = self._masks
        L, m, basis = self._basis.L, self._m, self._basis
        scol, srow, st, samp = transitions
        select = in_b[scol] & comp[srow]
        scol, srow = scol[select], srow[select]
        if np.any(~in_a[srow]):
            raise RuntimeError("U(sigma) maps B outside A: fold partition is inconsistent")
        orbit = basis.rep_orbit.astype(np.float64)
        data = samp[select] * self._table[(m * st[select]) % L] * np.sqrt(orbit[scol] / orbit[srow])
        return _csr(loc_a[srow], loc_b[scol], data, self.shape, dtype)

    def matrix(self) -> csr_matrix:
        """Explicit sparse S_AB (built once, from sigma_transitions)."""
        if self._matrix is None:
            self._matrix = self._sparse_part(self._basis.fold_transitions(), self.dtype)
        return self._matrix

    def apply(self, xB):
        """S_AB @ xB by one (n-1)-bit Walsh-Hadamard transform per necklace."""
        xB = np.asarray(xB)
        out_dtype = np.result_type(self.dtype, xB.dtype)
        if xB.ndim == 2:
            out = np.empty((self.shape[0], xB.shape[1]), dtype=out_dtype)
            for j in range(xB.shape[1]):
                out[:, j] = self.apply(xB[:, j])
            return out
        y = np.array(self.sparse @ xB, dtype=out_dtype)
        for count, half, src, scatter, rows, factor in self.groups:
            Z = np.empty(count * half, dtype=out_dtype)
            Z[scatter] = xB[src]
            _fwht_rows(Z.reshape(count, half))
            y[rows] += Z * factor
        return y


class SectorBlock:
    """Hamiltonian block for one momentum m and one Ising-category charge.

    Basis vectors (columns), in this order:
      "sigma": |a;k,-> for a in reps.
      "1"/"psi" (sign s=+1/-1): (|a;k,+> + s S|a;k,+>)/sqrt2 for a in reps (the set
          A), followed by sum_e U_E[e,j]|e;k,+> over e in e_reps (self-complementary
          necklaces, only for even L).
    For the folded charges the matrix is [[H_AA + s S_AB H_BA, W^H], [W, D]] with
    W = sqrt2 U_E^H H_EA and D = U_E^H H_EE U_E. H_AA, H_BA and S (a FoldCoupling
    representing S_AB) are shared by the "1" and "psi" blocks of the same momentum.
    """

    def __init__(self, L, m, charge, H, reps, *, sign=0, H_BA=None, S=None,
                 e_reps=None, U_E=None, W=None, D=None):
        self.L, self.m, self.charge = L, m, charge
        self.H = H
        self.reps = reps
        self.sign = sign
        self.H_BA, self.S = H_BA, S
        self.e_reps = np.empty(0, np.int64) if e_reps is None else e_reps
        self.U_E, self.W, self.D = U_E, W, D
        self._WH = None if W is None else W.getH().tocsr()
        n = H.shape[0] + (0 if W is None else W.shape[0])
        self.shape = (n, n)
        self.dtype = H.dtype

    @property
    def k(self) -> float:
        return 2.0 * math.pi * self.m / self.L

    @property
    def charge_eigenvalues(self) -> tuple[float, float, float]:
        return CHARGE_LAMBDA[self.charge]

    @property
    def folded(self) -> bool:
        return self.sign != 0

    @property
    def S_AB(self) -> csr_matrix:
        """Explicit sparse S_AB (built on first use)."""
        return self.S.matrix()

    def coupling_nnz_estimate(self) -> int:
        """Upper bound on nnz(S_AB @ H_BA) without forming it."""
        if not self.folded or self.H_BA.nnz == 0:
            return 0
        return int(np.dot(self.S.column_counts, np.diff(self.H_BA.indptr)))

    def coupling(self, x):
        """C x = S_AB (H_BA x) with the fast Walsh-Hadamard application of S_AB."""
        return self.S.apply(self.H_BA @ x)

    def to_csr(self) -> csr_matrix:
        """Explicit sparse matrix of the block."""
        if not self.folded:
            return self.H
        top = (self.H + self.sign * (self.S_AB @ self.H_BA)).tocsr()
        if self.W is None or self.W.shape[0] == 0:
            return top
        return bmat([[top, self._WH], [self.W, self.D]], format="csr")

    def to_dense(self) -> np.ndarray:
        return self.to_csr().toarray()

    def matvec(self, x):
        """Apply the block (factored form for the folded charges); x may be 2-D."""
        if not self.folded:
            return self.H @ x
        nA = self.H.shape[0]
        xa = x[:nA]
        y = self.H @ xa
        if self.H_BA.nnz:
            y = y + self.sign * self.coupling(xa)
        if self.W is None or self.W.shape[0] == 0:
            return y
        xe = x[nA:]
        return np.concatenate([y + self._WH @ xe, self.W @ xa + self.D @ xe])

    def operator(self, block_format: str = "auto"):
        """CSR matrix or LinearOperator for iterative eigensolvers.

        "auto" forms the explicit matrix only while S_AB H_BA is cheaper than its
        factored application (small L); larger blocks use H_AA x +- S_AB(H_BA x)
        with the Walsh-Hadamard form of S_AB.
        """
        if block_format not in ("auto", "explicit", "factored"):
            raise ValueError("block_format must be 'auto', 'explicit' or 'factored'")
        if not self.folded or block_format == "explicit":
            return self.to_csr()
        if block_format == "auto" and (self.coupling_nnz_estimate()
                                       <= self.S.cost + self.H_BA.nnz + 200_000):
            return self.to_csr()
        return LinearOperator(self.shape, matvec=self.matvec, rmatvec=self.matvec,
                              matmat=self.matvec, dtype=self.dtype)

    def __repr__(self) -> str:
        return (f"SectorBlock(L={self.L}, m={self.m}, charge={self.charge!r}, "
                f"dim={self.shape[0]}, dtype={np.dtype(self.dtype).name})")


def _self_dual_eigenvectors(S_EE: csr_matrix, classes: np.ndarray, dtype):
    """Eigenvectors of S inside each self-complementary necklace (tiny dense blocks)."""
    nE = S_EE.shape[0]
    bounds = np.flatnonzero(np.diff(classes)) + 1
    starts, ends = np.r_[0, bounds], np.r_[bounds, nE]
    entries = {1: ([], [], []), -1: ([], [], [])}
    counts = {1: 0, -1: 0}
    for a0, a1 in zip(starts, ends):
        block = S_EE[a0:a1, a0:a1].toarray()
        w, V = np.linalg.eigh(block)
        if (np.max(np.abs(block - block.conj().T)) > 1e-10
                or np.max(np.abs(np.abs(w) - 1.0)) > 1e-9):
            raise RuntimeError("S restricted to a self-complementary necklace is not "
                               "a Hermitian involution")
        for sign in (1, -1):
            vectors = V[:, w * sign > 0]
            rr, cc = np.nonzero(np.ones(vectors.shape, dtype=bool))
            rows, cols, vals = entries[sign]
            rows.append(a0 + rr)
            cols.append(counts[sign] + cc)
            vals.append(vectors[rr, cc])
            counts[sign] += vectors.shape[1]
    result = {}
    for sign in (1, -1):
        rows, cols, vals = entries[sign]
        result[sign] = _csr(np.concatenate(rows), np.concatenate(cols), np.concatenate(vals),
                            (nE, counts[sign]), dtype)
    return result


def build_symmetry_blocks(basis: SymmetryBasis, m: int, r: float, theta: float,
                          charges=CHARGES) -> dict[str, SectorBlock]:
    """All requested charge blocks {charge: SectorBlock} of momentum m.

    Columns are input kets, rows output kets. The "sigma" block is the
    U(psi)=-1 orbit block; "1" and "psi" share H_AA, H_BA and the fold coupling
    S and differ only in the sign of S_AB H_BA and in their E rows/columns.
    """
    m = basis.momentum(m)
    r, theta = _parameters(r, theta)
    charges = tuple(_charge(q) for q in charges)
    L = basis.L
    c, s = math.cos(theta), math.sin(theta)
    coefficient = np.array([-c, -s, -c / _SQRT2])        # Eq. (15) with Eq. (12) sign
    table, real = basis.phase_table(m)
    dtype = np.float64 if real else np.complex128
    col, row, t, f, kind = basis.hamiltonian_transitions()
    sqrt_orbit = np.sqrt(basis.rep_orbit.astype(np.float64))
    blocks: dict[str, SectorBlock] = {}

    def values(select, parity):
        cc, rr = col[select], row[select]
        v = coefficient[kind[select]] * (sqrt_orbit[cc] / sqrt_orbit[rr])
        v = v * table[(m * t[select].astype(np.int64)) % L]
        if parity == -1:
            v = v * (1 - 2 * f[select].astype(np.int64))
        return v.astype(dtype, copy=False)

    if "sigma" in charges:
        comp = basis.compatible(m, -1)
        reps = np.flatnonzero(comp)
        local = _local_index(comp)
        n = reps.size
        select = comp[col] & comp[row]
        H = _csr(np.concatenate([local[row[select]], np.arange(n)]),
                 np.concatenate([local[col[select]], np.arange(n)]),
                 np.concatenate([values(select, -1), -r * basis.rep_dw[reps]]),
                 (n, n), dtype)
        blocks["sigma"] = SectorBlock(L, m, "sigma", H, reps)

    folded = [q for q in charges if q != "sigma"]
    if folded:
        comp = basis.compatible(m, 1)
        part_a, part_b, part_e = basis.fold_partition()
        in_a, in_b, in_e = comp & part_a, comp & part_b, comp & part_e
        loc_a, loc_b, loc_e = _local_index(in_a), _local_index(in_b), _local_index(in_e)
        a_reps, e_reps = np.flatnonzero(in_a), np.flatnonzero(in_e)
        nA, nB, nE = a_reps.size, int(in_b.sum()), e_reps.size
        from_a = in_a[col]
        select = from_a & in_a[row]
        H_AA = _csr(np.concatenate([loc_a[row[select]], np.arange(nA)]),
                    np.concatenate([loc_a[col[select]], np.arange(nA)]),
                    np.concatenate([values(select, 1), -r * basis.rep_dw[a_reps]]),
                    (nA, nA), dtype)
        select = from_a & in_b[row]
        H_BA = _csr(loc_b[row[select]], loc_a[col[select]], values(select, 1), (nB, nA), dtype)
        S = FoldCoupling(basis, m, comp, in_a, in_b, loc_a, loc_b, table, dtype)
        if np.any((np.diff(H_BA.indptr) > 0) & (S.column_counts == 0)):
            raise RuntimeError("H couples A to B representatives outside the fold interface")
        vectors = {1: None, -1: None}
        if nE:
            select = from_a & in_e[row]
            H_EA = _csr(loc_e[row[select]], loc_a[col[select]], values(select, 1), (nE, nA), dtype)
            select = in_e[col] & in_e[row]
            H_EE = _csr(np.concatenate([loc_e[row[select]], np.arange(nE)]),
                        np.concatenate([loc_e[col[select]], np.arange(nE)]),
                        np.concatenate([values(select, 1), -r * basis.rep_dw[e_reps]]),
                        (nE, nE), dtype)
            scol, srow, st, samp = basis.fold_structure()[1]
            select = in_e[scol] & comp[srow]
            scol, srow = scol[select], srow[select]
            if np.any(~in_e[srow]):
                raise RuntimeError("U(sigma) maps E outside E: fold partition is inconsistent")
            sdata = samp[select] * table[(m * st[select]) % L] * (sqrt_orbit[scol] / sqrt_orbit[srow])
            S_EE = _csr(loc_e[srow], loc_e[scol], sdata, (nE, nE), dtype)
            vectors = _self_dual_eigenvectors(S_EE, basis.rep_g[e_reps], dtype)
        for q in folded:
            sign = _FOLD_SIGN[q]
            U = W = D = None
            if nE:
                U = vectors[sign]
                UH = U.getH().tocsr()
                W = (_SQRT2 * (UH @ H_EA)).tocsr()
                D = (UH @ H_EE @ U).tocsr()
            blocks[q] = SectorBlock(L, m, q, H_AA, a_reps, sign=sign, H_BA=H_BA, S=S,
                                    e_reps=e_reps, U_E=U, W=W, D=D)
    return {q: blocks[q] for q in charges}


def build_hamiltonian_block(basis: SymmetryBasis, m: int, charge: str, r: float,
                            theta: float) -> SectorBlock:
    """Single (m, charge) block. Use build_symmetry_blocks to share work between charges."""
    return build_symmetry_blocks(basis, m, r, theta, charges=(_charge(charge),))[charge]


def sector_dimensions(basis: SymmetryBasis, m: int) -> dict[str, int]:
    """Dimensions of the three charge blocks at momentum m, without building them.

    Inside E, S is a Hermitian involution, so dim E_(+-) = (|E| +- tr S_EE)/2.
    """
    m = basis.momentum(m)
    L = basis.L
    comp = basis.compatible(m, 1)
    part_a, _, part_e = basis.fold_partition()
    n_a, in_e = int((comp & part_a).sum()), comp & part_e
    scol, srow, st, samp = basis.fold_structure()[1]
    diagonal = in_e[scol] & (scol == srow)
    table, _ = basis.phase_table(m)
    trace = float(np.real(np.sum(samp[diagonal] * table[(m * st[diagonal]) % L])))
    n_plus = (int(in_e.sum()) + round(trace)) // 2
    return {"1": n_a + n_plus, "psi": n_a + int(in_e.sum()) - n_plus,
            "sigma": int(basis.compatible(m, -1).sum())}


