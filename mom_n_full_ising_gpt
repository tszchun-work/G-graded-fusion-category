I, PSI, SIGMA = 0, 1, 2
State = tuple[int, ...]

CHARGES = ("1", "psi", "sigma")
CHARGE_LAMBDA = {  # (lambda_1, lambda_psi, lambda_sigma), Eq. (24)
    "1": (1.0, 1.0, math.sqrt(2.0)),
    "psi": (1.0, 1.0, -math.sqrt(2.0)),
    "sigma": (1.0, -1.0, 0.0),
}
_FOLD_SIGN = {"1": 1, "psi": -1, "sigma": 0}
_SQRT2 = math.sqrt(2.0)


def _integer(value: int, name: str) -> int:
    if isinstance(value, bool) or not isinstance(value, Integral):
        raise TypeError(f"{name} must be an integer, not {value!r}")
    return int(value)


def _parameters(r: float, theta: float) -> tuple[float, float]:
    for name, value in (("r", r), ("theta", theta)):
        if not isinstance(value, Real) or not math.isfinite(value):
            raise ValueError(f"{name} must be a finite real number")
    return float(r), float(theta)


def _charge(charge: str) -> str:
    if charge not in CHARGE_LAMBDA:
        raise ValueError(f"charge must be one of {CHARGES}, not {charge!r}")
    return charge


def hilbert_dimension(L: int) -> int:
    """Exact trace(A**L), without cancellation or floating-point powers.

    A=[[1,0,1],[0,1,1],[1,1,1]]. For S_L=(1+sqrt(2))**L+
    (1-sqrt(2))**L, S_0=S_1=2 and S_L=2*S_{L-1}+S_{L-2}.
    """
    L = _integer(L, "L")
    if L < 0:
        raise ValueError("L must be nonnegative")
    if L == 0:
        return 3
    previous, current = 2, 2
    for _ in range(2, L + 1):
        previous, current = current, 2 * current + previous
    return 1 + current


# =============================================================================
# Reference implementation on explicit tuples (small L). Used for validation.
# =============================================================================

def is_valid_state(state) -> bool:
    """Exactly the paper's periodic x-label basis, including the closing bond.

    Same-grade neighbours require a_i=I and therefore equal x labels. Different
    grades uniquely require a_i=SIGMA. SIGMA--SIGMA uses a_i=I as required by
    Eq. (8). Hence only adjacent I--PSI and PSI--I are forbidden.
    """
    if len(state) == 0:
        return False
    if any(x not in (I, PSI, SIGMA) for x in state):
        return False
    return all(not ((a == I and b == PSI) or (a == PSI and b == I))
               for a, b in zip(state, tuple(state[1:]) + (state[0],)))


def translate(state: State, steps: int = 1) -> State:
    """Right translation T**steps, identical to tuple(np.roll(state,steps))."""
    steps = _integer(steps, "steps") % len(state)
    return state[-steps:] + state[:-steps] if steps else state


def _psi_flip(state: State) -> State:
    return tuple(1 - x if x != SIGMA else SIGMA for x in state)


def _local_action_valid(state: State, r: float, c: float, s: float):
    """Apply H=-sum_i(H_dw+H_flip) to a known valid state (Eqs. 12-15).

    Duplicate outputs are intentional; sparse COO assembly sums them.
    """
    L = len(state)
    diagonal = 0.0
    for j in range(L):
        left, mid, right = state[(j - 1) % L], state[j], state[(j + 1) % L]
        lm, mm, rm = left != SIGMA, mid != SIGMA, right != SIGMA
        if lm != rm:                            # Eq. (14), contributes -r
            diagonal -= r
        transitions: tuple[tuple[int, float], ...] = ()
        if lm and mm and rm:                    # |mu mu mu>
            transitions = ((SIGMA, c),)
        elif lm and mm and not rm:              # |mu mu sigma>
            transitions = ((SIGMA, s),)
        elif lm and not mm and rm:              # |mu sigma nu>
            if left == right:
                transitions = ((left, c),)
        elif not lm and mm and rm:              # |sigma mu mu>
            transitions = ((SIGMA, s),)
        elif lm and not mm and not rm:          # |mu sigma sigma>
            transitions = ((left, s),)
        elif not lm and mm and not rm:          # |sigma mu sigma>
            transitions = ((SIGMA, c / math.sqrt(2.0)),)
        elif not lm and not mm and rm:          # |sigma sigma mu>
            transitions = ((right, s),)
        elif not lm and not mm and not rm:      # |sigma sigma sigma>
            amplitude = c / math.sqrt(2.0)
            transitions = ((I, amplitude), (PSI, amplitude))
        for new_mid, amplitude in transitions:
            if amplitude != 0.0:
                target = state[:j] + (new_mid,) + state[j + 1:]
                yield target, -amplitude         # Eq. (12) minus sign
    if diagonal != 0.0:
        yield state, diagonal


def local_action(state, r: float, theta: float) -> Iterator[tuple[State, float]]:
    """Yield (target_state, coefficient) for H|state>, including diagonal terms."""
    state = tuple(state)
    if len(state) < 3 or not is_valid_state(state):
        raise ValueError("state must be a valid periodic fusion-label state of L>=3")
    r, theta = _parameters(r, theta)
    yield from _local_action_valid(state, r, math.cos(theta), math.sin(theta))


def symmetry_action(state: State, label: str) -> Iterator[tuple[State, float]]:
    """Full-basis action of U(psi) or U(sigma), Eqs. (18)--(21).

    Eq. (20) uses I=0, PSI=1 in its exponent. Each old sigma domain becomes
    a new uniform mu' domain. Its sign is (-1)**((mu_left+mu_right)*mu').
    """
    state = tuple(state)
    if len(state) < 3 or not is_valid_state(state):
        raise ValueError("symmetry_action requires a valid state of L>=3")
    if label == "psi":
        yield _psi_flip(state), 1.0
        return
    if label != "sigma":
        raise ValueError("label must be 'psi' or 'sigma'")
    L = len(state)
    if len(set(state)) == 1:                     # Eq. (21), special n=0 case
        if state[0] == SIGMA:
            yield (I,) * L, 1.0
            yield (PSI,) * L, 1.0
        else:
            yield (SIGMA,) * L, 1.0
        return
    domains = []
    for j in range(L):
        if state[j] == SIGMA and state[(j - 1) % L] != SIGMA:
            sites = []
            end = j
            while state[end] == SIGMA:
                sites.append(end)
                end = (end + 1) % L
            domains.append((sites, state[(j - 1) % L] + state[end]))
    amplitude = 2.0 ** (-len(domains) / 2.0)
    for values in product((I, PSI), repeat=len(domains)):
        target = [SIGMA] * L
        exponent = 0
        for value, (sites, boundary_sum) in zip(values, domains):
            exponent += boundary_sum * value
            for site in sites:
                target[site] = value
        yield tuple(target), amplitude * (-1 if exponent % 2 else 1)


class FullBasis:
    """Every valid state as a tuple. Reference/validation only (exponential memory)."""

    def __init__(self, L: int, max_states: int | None = 2_000_000):
        self.L = _integer(L, "L")
        if self.L < 3:
            raise ValueError("L must be >=3 so each three-site term has distinct sites")
        dimension = hilbert_dimension(self.L)
        if max_states is not None and dimension > _integer(max_states, "max_states"):
            raise MemoryError(f"L={L} has {dimension:,} states, above max_states={max_states:,}")
        allowed = {I: (I, SIGMA), PSI: (PSI, SIGMA), SIGMA: (I, PSI, SIGMA)}
        states: list[State] = []

        def extend(prefix: list[int]) -> None:
            if len(prefix) == self.L:
                if prefix[0] in allowed[prefix[-1]]:  # periodic closing bond
                    states.append(tuple(prefix))
                return
            for label in allowed[prefix[-1]]:
                prefix.append(label)
                extend(prefix)
                prefix.pop()

        for first in (I, PSI, SIGMA):
            extend([first])
        if len(states) != dimension:
            raise RuntimeError("Basis enumeration failed the exact dimension identity")
        self.states = tuple(states)
        self.state_to_index = {state: i for i, state in enumerate(self.states)}

    def __len__(self) -> int:
        return len(self.states)


def full_hamiltonian(basis: FullBasis, r: float, theta: float) -> csr_matrix:
    """Unprojected real Hamiltonian on the explicit basis."""
    r, theta = _parameters(r, theta)
    c, s = math.cos(theta), math.sin(theta)
    rows, columns, data = [], [], []
    for col, state in enumerate(basis.states):
        for target, coefficient in _local_action_valid(state, r, c, s):
            rows.append(basis.state_to_index[target])
            columns.append(col)
            data.append(coefficient)
    result = coo_matrix((data, (rows, columns)), shape=(len(basis), len(basis)),
                        dtype=np.float64).tocsr()
    result.eliminate_zeros()
    return result


def translation_operator(basis: FullBasis) -> csr_matrix:
    rows = [basis.state_to_index[translate(state)] for state in basis.states]
    return coo_matrix((np.ones(len(basis)), (rows, np.arange(len(basis)))),
                      shape=(len(basis), len(basis))).tocsr()


def symmetry_operator(basis: FullBasis, label: str, max_nnz: int = 10_000_000) -> csr_matrix:
    """Explicit categorical symmetry (reference, small L)."""
    rows, columns, data = [], [], []
    for col, state in enumerate(basis.states):
        for target, coefficient in symmetry_action(state, label):
            if len(data) >= max_nnz:
                raise MemoryError("Explicit symmetry matrix exceeded max_nnz guard")
            rows.append(basis.state_to_index[target])
            columns.append(col)
            data.append(coefficient)
    return coo_matrix((data, (rows, columns)), shape=(len(basis), len(basis)),
                      dtype=np.float64).tocsr()


# =============================================================================
# Vectorized bit kernels
# =============================================================================

if hasattr(np, "bitwise_count"):                       # NumPy >= 2.0
    def _popcount(x):
        return np.bitwise_count(x).astype(np.int64)
else:                                                  # pragma: no cover
    _POP8 = np.array([bin(i).count("1") for i in range(256)], dtype=np.int64)

    def _popcount(x):
        x = np.asarray(x, dtype=np.int64)
        total = np.zeros(x.shape, dtype=np.int64)
        for shift in range(0, 64, 8):
            total += _POP8[(x >> shift) & 0xFF]
        return total


def _divisors(n: int) -> list[int]:
    return [d for d in range(1, n + 1) if n % d == 0]


def _deposit(bits, positions, nbits: int):
    """Scatter bit d of `bits` onto the d-th lowest set bit of `positions` (d < nbits)."""
    out = np.zeros_like(positions)
    remaining = positions.copy()
    for d in range(nbits):
        lowest = remaining & -remaining
        out |= lowest * ((bits >> d) & 1)
        remaining ^= lowest
    return out


def _extract(x, positions, nbits: int):
    """Gather the bits of x at the nbits lowest set bits of `positions` (inverse of _deposit)."""
    out = np.zeros_like(positions)
    remaining = positions.copy()
    for d in range(nbits):
        lowest = remaining & -remaining
        out |= ((x & lowest) != 0).astype(np.int64) << d
        remaining ^= lowest
    return out


def _fwht_rows(Z) -> None:
    """In-place unnormalized Walsh-Hadamard transform of every row of a contiguous (C, N) array."""
    C, N = Z.shape
    h = 1
    while h < N:
        view = Z.reshape(C, N // (2 * h), 2, h)
        a, b = view[:, :, 0, :], view[:, :, 1, :]
        difference = a - b
        a += b
        b[...] = difference
        h <<= 1


def _csr(rows, cols, data, shape, dtype) -> csr_matrix:
    result = coo_matrix((np.asarray(data, dtype=dtype), (rows, cols)),
                        shape=shape, dtype=dtype).tocsr()
    result.eliminate_zeros()
    return result


def _local_index(mask) -> np.ndarray:
    index = np.full(mask.size, -1, dtype=np.int64)
    index[mask] = np.arange(int(mask.sum()))
    return index


# =============================================================================
# Symmetry-adapted basis: orbits of G = <T, U(psi)> = Z_L x Z_2
# =============================================================================

class SymmetryBasis:
    """Orbit representatives of G = <T> x <U(psi)>, stored as bit masks.

    Enumeration, Hamiltonian structure and U(sigma) structure are fully
    vectorized and independent of (r, theta, m), so they are computed once and
    reused for every momentum, charge and parameter point. Only about D/(2L)
    representatives and ~L Hamiltonian transitions each are stored, never all D
    states (L=20: 1.1e6 representatives, 2.3e7 transitions, ~0.3 GB, a few
    seconds). max_states is a guard on D, not a memory guarantee.
    """

    def __init__(self, L: int, max_states: int | None = 300_000_000):
        self.L = L = _integer(L, "L")
        if L < 3:
            raise ValueError("L must be >=3 so each three-site term has distinct sites")
        if L > 30:
            raise ValueError("L <= 30 is required by the 2L-bit integer encoding")
        self.dimension = hilbert_dimension(L)
        if max_states is not None:
            max_states = _integer(max_states, "max_states")
            if max_states < 1:
                raise ValueError("max_states must be positive or None")
            if self.dimension > max_states:
                raise MemoryError(
                    f"L={L} has {self.dimension:,} valid states, exceeding max_states="
                    f"{max_states:,}. Explicit ED is exponential; raise the guard only "
                    "with sufficient memory.")
        self.mask = (1 << L) - 1
        self._build_grade_tables()
        self._enumerate_representatives()
        self._hamiltonian = None
        self._fold = None
        self._fold_fast = None
        self._partition = None

    def __len__(self) -> int:
        return self.dimension

    # ---- bit helpers --------------------------------------------------------
    def _rotl(self, x, t: int):
        """Right translation T**t of a bit mask (bit i -> bit i+t)."""
        t %= self.L
        if t == 0:
            return x
        return ((x << t) | (x >> (self.L - t))) & self.mask

    def _rotl_var(self, x, t):
        """Elementwise T**t for an array of shifts 0 <= t < L."""
        return ((x << t) | (x >> (self.L - t))) & self.mask

    def _fill(self, x, conn):
        """Copy set bits of x from site i-1 to site i wherever conn bit i is set."""
        step = 1
        while step < self.L:
            x = x | (self._rotl(x, step) & conn)
            conn = conn & self._rotl(conn, step)
            step <<= 1
        return x

    def momentum(self, m: int) -> int:
        return _integer(m, "m") % self.L

    def encode(self, state) -> tuple[int, int]:
        """(g, l) bit masks of an x-label tuple."""
        g = sum(1 << i for i, x in enumerate(state) if x == SIGMA)
        l = sum(1 << i for i, x in enumerate(state) if x == PSI)
        return g, l

    def rep_state(self, index: int) -> State:
        """x-label tuple of representative `index`."""
        g, l = int(self.rep_g[index]), int(self.rep_l[index])
        return tuple(SIGMA if (g >> i) & 1 else (l >> i) & 1 for i in range(self.L))

    # ---- enumeration --------------------------------------------------------
    def _build_grade_tables(self) -> None:
        """Canonical rotation, rotation to it, and period of every grade mask."""
        L = self.L
        g = np.arange(1 << L, dtype=np.int64)
        canon = g.copy()
        to_canon = np.zeros(1 << L, dtype=np.int8)
        current = g
        for t in range(1, L):
            current = self._rotl(current, 1)
            better = current < canon
            canon[better] = current[better]
            to_canon[better] = t
        period = np.full(1 << L, L, dtype=np.int8)
        for d in _divisors(L)[:-1]:
            hit = (period == L) & (self._rotl(g, d) == g)
            period[hit] = d
        self._canon, self._to_canon, self._gperiod = canon, to_canon, period

    def _enumerate_representatives(self) -> None:
        L, mask = self.L, self.mask
        grades = np.arange(1 << L, dtype=np.int64)
        necklaces = grades[self._canon == grades]
        mu = ~necklaces & mask
        starts = mu & self._rotl(necklaces, 1)      # mu sites whose left neighbour is sigma
        ndomains = _popcount(starts)
        # uniform states: all-I, all-psi, all-sigma
        gs = [np.array([0, 0, mask], dtype=np.int64)]
        ls = [np.array([0, mask, 0], dtype=np.int64)]
        for n in range(1, L // 2 + 1):             # one free Z_2 label per mu domain
            select = ndomains == n
            if not np.any(select):
                continue
            count = 1 << n
            g = np.repeat(necklaces[select], count)
            mu_g = ~g & mask
            labels = _deposit(np.tile(np.arange(count, dtype=np.int64), int(select.sum())),
                              np.repeat(starts[select], count), n)
            ls.append(self._fill(labels, mu_g & self._rotl(mu_g, 1)))
            gs.append(g)
        g, l = np.concatenate(gs), np.concatenate(ls)
        # keep the smallest label mask over the stabilizer {T^{jP}} x {1, U(psi)}
        mu = ~g & mask
        lmin = np.minimum(l, l ^ mu)
        P = self._gperiod[g].astype(np.int64)
        periodic = np.flatnonzero(P < L)
        if periodic.size:
            lp, mp, Pp, best = l[periodic], mu[periodic], P[periodic], lmin[periodic]
            for t in range(1, L):
                a = np.flatnonzero(t % Pp == 0)
                if a.size:
                    candidate = np.minimum(self._rotl(lp[a], t), self._rotl(lp[a] ^ mp[a], t))
                    best[a] = np.minimum(best[a], candidate)
            lmin[periodic] = best
        keep = l == lmin
        g, l = g[keep], l[keep]
        code = (g << L) | l
        order = np.argsort(code)
        self.rep_g, self.rep_l, self.rep_code = g[order], l[order], code[order]
        n_reps = self.rep_g.size
        # translation period R and psi twist t_psi: T^{t_psi} U(psi) |a> = |a>
        R = np.full(n_reps, L, dtype=np.int64)
        for d in _divisors(L)[:-1]:
            hit = ((R == L) & (self._rotl(self.rep_g, d) == self.rep_g)
                   & (self._rotl(self.rep_l, d) == self.rep_l))
            R[hit] = d
        tpsi = np.full(n_reps, -1, dtype=np.int64)
        flipped = self.rep_l ^ (~self.rep_g & mask)
        for t in range(L):
            hit = ((tpsi < 0) & (t < R) & (self._rotl(self.rep_g, t) == self.rep_g)
                   & (self._rotl(flipped, t) == self.rep_l))
            tpsi[hit] = t
        self.n_reps = n_reps
        self.rep_period = R
        self.rep_tpsi = tpsi
        self.rep_orbit = np.where(tpsi < 0, 2 * R, R)          # |O_a|
        self.rep_nsigma = _popcount(self.rep_g)
        self.rep_cclass = self._canon[~self.rep_g & mask]      # necklace of U(sigma) image
        self.rep_dw = _popcount(self._rotl(self.rep_g, 1) ^ self._rotl(self.rep_g, L - 1))
        if int(self.rep_orbit.sum()) != self.dimension:
            raise RuntimeError("Orbit enumeration failed the exact dimension identity")

    # ---- targets -> representatives ----------------------------------------
    def locate(self, g, l):
        """Return (rep index, t, f) with T**t U(psi)**f (g, l) = representative."""
        L, mask = self.L, self.mask
        g = np.asarray(g, dtype=np.int64)
        l = np.asarray(l, dtype=np.int64)
        gc = self._canon[g]
        t = self._to_canon[g].astype(np.int64)
        l0 = self._rotl_var(l, t)
        l1 = l0 ^ (~gc & mask)
        f = (l1 < l0).astype(np.int8)
        best = np.minimum(l0, l1)
        periodic = np.flatnonzero(self._gperiod[gc] < L)
        if periodic.size:                        # rare: grade pattern with period < L
            P = self._gperiod[gc[periodic]].astype(np.int64)
            sources = (l0[periodic], l1[periodic])
            bb, tb, fb = best[periodic], t[periodic], f[periodic]
            base = tb.copy()
            for s in range(1, L):
                a = np.flatnonzero(s % P == 0)
                if a.size == 0:
                    continue
                for flip, source in enumerate(sources):
                    candidate = self._rotl(source[a], s)
                    better = candidate < bb[a]
                    idx = a[better]
                    bb[idx] = candidate[better]
                    tb[idx] = base[idx] + s
                    fb[idx] = flip
            best[periodic], t[periodic], f[periodic] = bb, tb, fb
        code = (gc << L) | best
        rows = np.minimum(np.searchsorted(self.rep_code, code), self.n_reps - 1)
        if np.any(self.rep_code[rows] != code):
            raise RuntimeError("A target state has no representative (invalid state?)")
        return rows, t % L, f

    # ---- operator structure (independent of r, theta, m) -------------------
    def hamiltonian_transitions(self):
        """Off-diagonal structure of H on representatives, Eqs. (12)-(15).

        Returns (col, row, t, f, kind): H|rep[col]> contains COEF[kind]*|s>
        with T**t U(psi)**f s = rep[row], and COEF = (-cos theta, -sin theta,
        -cos(theta)/sqrt2) for kind = 0, 1, 2. Diagonal: -r * rep_dw.
        """
        if self._hamiltonian is not None:
            return self._hamiltonian
        L = self.L
        g, l = self.rep_g, self.rep_l
        index_dtype = np.int32 if self.n_reps < 2**31 else np.int64
        pieces: list[tuple] = []
        for j in range(L):
            jm, jp = (j - 1) % L, (j + 1) % L
            bit = np.int64(1 << j)
            gL, gM, gR = (g >> jm) & 1, (g >> j) & 1, (g >> jp) & 1
            lL, lR = (l >> jm) & 1, (l >> jp) & 1
            parts = []
            # mid mu -> sigma: |mu mu mu> (c), |mu mu s>,|s mu mu> (s), |s mu s> (c/sqrt2)
            sel = np.flatnonzero(gM == 0)
            neighbours = gL[sel] + gR[sel]
            parts.append((sel, g[sel] | bit, l[sel] & ~bit, neighbours.astype(np.int8)))
            is_sigma = gM == 1
            # |mu s nu> -> delta_{mu nu} |mu mu mu> (c)
            sel = np.flatnonzero(is_sigma & (gL == 0) & (gR == 0) & (lL == lR))
            parts.append((sel, g[sel] & ~bit, l[sel] | (lL[sel] << j), np.zeros(sel.size, np.int8)))
            # |mu s s> -> |mu mu s> (s)
            sel = np.flatnonzero(is_sigma & (gL == 0) & (gR == 1))
            parts.append((sel, g[sel] & ~bit, l[sel] | (lL[sel] << j), np.ones(sel.size, np.int8)))
            # |s s mu> -> |s mu mu> (s)
            sel = np.flatnonzero(is_sigma & (gL == 1) & (gR == 0))
            parts.append((sel, g[sel] & ~bit, l[sel] | (lR[sel] << j), np.ones(sel.size, np.int8)))
            # |s s s> -> (|s I s> + |s psi s>) (c/sqrt2)
            sel = np.flatnonzero(is_sigma & (gL == 1) & (gR == 1))
            parts.append((sel, g[sel] & ~bit, l[sel], np.full(sel.size, 2, np.int8)))
            parts.append((sel, g[sel] & ~bit, l[sel] | bit, np.full(sel.size, 2, np.int8)))
            col = np.concatenate([p[0] for p in parts])
            row, t, f = self.locate(np.concatenate([p[1] for p in parts]),
                                    np.concatenate([p[2] for p in parts]))
            pieces.append((col.astype(index_dtype), row.astype(index_dtype),
                           t.astype(np.int16), f, np.concatenate([p[3] for p in parts])))
        self._hamiltonian = tuple(np.concatenate(x) for x in zip(*pieces))
        return self._hamiltonian

    def sigma_transitions(self, reps):
        """S = U(sigma)/sqrt2 restricted to U(psi)=+1, acting on the given reps.

        Eq. (20): the n sigma domains become mu' domains with amplitude 2**(-n/2)
        and sign (-1)**((mu_left+mu_right) mu'). Images related by U(psi) have equal
        signs and the same representative on U(psi)=+1, so only 2**(n-1) images are
        generated and doubled: S|a> has 2**(n-1) terms of amplitude 2**((1-n)/2).
        Returns (col, row, t, amp) with T**t U(psi)**f image = rep[row].
        """
        L, mask = self.L, self.mask
        reps = np.asarray(reps, dtype=np.int64)
        g, l = self.rep_g[reps], self.rep_l[reps]
        cols, tg, tl, amps = [], [], [], []
        uniform_sigma = np.flatnonzero(g == mask)       # |s..s> -> |I..I> + |psi..psi>
        if uniform_sigma.size:
            cols.append(reps[uniform_sigma])
            tg.append(np.zeros(uniform_sigma.size, np.int64))
            tl.append(np.zeros(uniform_sigma.size, np.int64))
            amps.append(np.full(uniform_sigma.size, _SQRT2))
        uniform_mu = np.flatnonzero(g == 0)             # |I..I>, |psi..psi> -> |s..s>
        if uniform_mu.size:
            cols.append(reps[uniform_mu])
            tg.append(np.full(uniform_mu.size, mask, np.int64))
            tl.append(np.zeros(uniform_mu.size, np.int64))
            amps.append(np.full(uniform_mu.size, 1.0 / _SQRT2))
        generic = np.flatnonzero((g != 0) & (g != mask))
        if generic.size:
            gg, ll, rr = g[generic], l[generic], reps[generic]
            sstart = gg & ~self._rotl(gg, 1) & mask      # first site of each sigma domain
            send = gg & ~self._rotl(gg, L - 1) & mask    # last site of each sigma domain
            wl = sstart & self._rotl(ll, 1)              # left neighbour is psi
            wr = send & self._rotl(ll, L - 1)            # right neighbour is psi
            conn = gg & self._rotl(gg, 1)
            ndom = _popcount(sstart)
            for n in np.unique(ndom):
                n = int(n)
                sub = np.flatnonzero(ndom == n)
                count = 1 << (n - 1)                     # highest domain keeps label I

                def rep(a, sub=sub, count=count):
                    return np.repeat(a[sub], count)

                labels = _deposit(np.tile(np.arange(count, dtype=np.int64), sub.size),
                                  rep(sstart), n - 1)
                labels = self._fill(labels, rep(conn))
                exponent = _popcount(labels & rep(wl)) + _popcount(labels & rep(wr))
                cols.append(rep(rr))
                tg.append(~rep(gg) & mask)
                tl.append(labels)
                amps.append(2.0 ** ((1 - n) / 2.0) * (1 - 2 * (exponent & 1)))
        if not cols:
            empty = np.empty(0, np.int64)
            return empty, empty, empty, np.empty(0)
        row, t, _ = self.locate(np.concatenate(tg), np.concatenate(tl))
        return np.concatenate(cols), row, t, np.concatenate(amps).astype(np.float64)

    def fold_partition(self):
        """Boolean masks (A, B, E) over representatives for the U(psi)=+1 fold."""
        if self._partition is None:
            L = self.L
            n2 = 2 * self.rep_nsigma
            middle = n2 == L
            cls, ccls = self.rep_g, self.rep_cclass
            self._partition = ((n2 < L) | (middle & (cls < ccls)),
                               (n2 > L) | (middle & (cls > ccls)),
                               middle & (cls == ccls))
        return self._partition

    def _fold_interface(self):
        """B representatives at the fold and the self-complementary set E.

        Only these enter the charge-1/psi blocks: for odd L the layer
        n_s=(L+1)/2; for even L the layers n_s=L/2 (B and E) and n_s=L/2+1.
        """
        L = self.L
        n2 = 2 * self.rep_nsigma
        _, in_b, in_e = self.fold_partition()
        return ((n2 == L + 1) | (n2 == L + 2) | (n2 == L)) & in_b, in_e

    def fold_transitions(self):
        """Sparse S transitions (col, row, t, amp) from all interface B reps and E (cached).

        Only needed for explicit matrices; Lanczos uses fold_structure() instead.
        """
        if self._fold is None:
            interface, in_e = self._fold_interface()
            self._fold = self.sigma_transitions(np.flatnonzero(interface | in_e))
        return self._fold

    def fold_structure(self):
        """Fast Walsh-Hadamard form of S on the fold (cached, independent of m).

        For an interface B necklace g with period L and n sigma domains, the
        2**(n-1) representatives of the class and the 2**(n-1) images in the
        necklace of gbar are related by (Eq. 20)

            S[nu, b] = 2**((1-n)/2) e^{ik t0} (-1)**(nu . w(b)),

        where w_e = mu_left(e) XOR mu_right(e) for sigma domain e, nu is the new
        label vector with the top domain fixed to I, and t0 the rotation taking
        gbar to its canonical form. Because w has even parity, nu.w only involves
        the lower n-1 bits: S is a single (n-1)-bit Walsh-Hadamard transform per
        necklace, O(n 2**n) work instead of O(4**n). Periodic interface necklaces
        and E (rare, tiny) keep sparse transitions.

        Returns (groups, small): one dict per n with keys n, half, count, b_reps,
        scatter, out_reps, out_t; and sparse (col, row, t, amp) for the rest.
        """
        if self._fold_fast is None:
            L, mask = self.L, self.mask
            interface, in_e = self._fold_interface()
            aperiodic = self._gperiod[self.rep_g] == L
            fast = np.flatnonzero(interface & aperiodic)
            small = self.sigma_transitions(np.flatnonzero((interface & ~aperiodic) | in_e))
            g, l = self.rep_g[fast], self.rep_l[fast]
            sstart = g & ~self._rotl(g, 1) & mask
            send = g & ~self._rotl(g, L - 1) & mask
            ndom = _popcount(sstart)
            nmax = int(ndom.max()) if ndom.size else 0
            # Canonical grades have a mu site at L-1, so no sigma domain wraps around
            # and the j-th start and j-th end belong to the same domain.
            w = (_extract(sstart & self._rotl(l, 1), sstart, nmax)
                 ^ _extract(send & self._rotl(l, L - 1), send, nmax))
            groups = []
            for n in np.unique(ndom):
                n = int(n)
                half = 1 << (n - 1)
                select = np.flatnonzero(ndom == n)
                classes, position = np.unique(g[select], return_inverse=True)
                scatter = position * half + (w[select] & (half - 1))
                if (select.size != classes.size * half
                        or np.any(np.bincount(scatter, minlength=select.size) != 1)):
                    raise RuntimeError("Walsh-Hadamard fold structure is inconsistent")
                starts_c = classes & ~self._rotl(classes, 1) & mask
                conn_c = classes & self._rotl(classes, 1)
                nu = np.tile(np.arange(half, dtype=np.int64), classes.size)
                labels = self._fill(_deposit(nu, np.repeat(starts_c, half), n - 1),
                                    np.repeat(conn_c, half))
                out_reps, out_t, _ = self.locate(np.repeat(~classes & mask, half), labels)
                groups.append({"n": n, "half": half, "count": classes.size,
                               "b_reps": fast[select], "scatter": scatter,
                               "out_reps": out_reps, "out_t": out_t})
            outputs = np.concatenate([grp["out_reps"] for grp in groups]) if groups else []
            if len(np.unique(outputs)) != len(outputs):
                raise RuntimeError("Walsh-Hadamard fold outputs are not distinct")
            self._fold_fast = (groups, small)
        return self._fold_fast

    # ---- sectors -------------------------------------------------------------
    def compatible(self, m: int, parity: int) -> np.ndarray:
        """Representatives whose symmetric ket survives in sector (k=2 pi m/L, U(psi)=parity).

        Requires chi = 1 on the stabilizer: e^{ikR} = 1 and, if T^{t_psi} U(psi)
        fixes the state, e^{ik t_psi} * parity = 1. Pure integer arithmetic.
        """
        L = self.L
        m = self.momentum(m)
        if parity not in (1, -1):
            raise ValueError("parity must be +1 or -1")
        ok = (m * self.rep_period) % L == 0
        twisted = self.rep_tpsi >= 0
        if parity == 1:
            ok &= ~twisted | ((m * self.rep_tpsi) % L == 0)
        elif L % 2:
            ok &= ~twisted
        else:
            ok &= ~twisted | ((m * self.rep_tpsi) % L == L // 2)
        return ok

    def phase_table(self, m: int):
        """(e^{2 pi i j/L} for j < L, is_real). Index it with (m*t) % L."""
        m = self.momentum(m)
        table = np.exp(2j * np.pi * np.arange(self.L) / self.L)
        if m == 0 or 2 * m == self.L:
            return table.real.copy(), True        # only j=0 or j=L/2 occur: exactly +-1
        return table, False


