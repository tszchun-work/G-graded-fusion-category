_COLORS = {"1": "tab:red", "psi": "tab:blue", "sigma": "tab:green"}
_LABELS = {"1": r"$(1,1,\sqrt{2})$", "psi": r"$(1,1,-\sqrt{2})$", "sigma": r"$(1,-1,0)$"}


def plot_spectrum(spectrum: dict, L: int, *, rescale: bool = False, ymax: float | None = None,
                  title: str | None = None, save: Path | None = None, show: bool = True):
    """Paper-style E(k) plot coloured by charge (cf. Fig. 3)."""
    import matplotlib.pyplot as plt
    from matplotlib.ticker import MaxNLocator

    E0 = min(float(np.min(v)) for v in spectrum.values() if len(v))
    scale, ylabel = 1.0, "Energy $E-E_0$"
    if rescale:
        # Fig. 3(b): lowest charge-1 state at m=2 (stress tensor) has E=2.
        stress = spectrum.get((2 % L, "1"))
        if stress is None or not len(stress) or float(stress[0]) - E0 <= 0:
            raise ValueError("rescale needs the (m=2, charge 1) sector")
        scale, ylabel = 2.0 / (float(stress[0]) - E0), r"Rescaled $E-E_0$"
    offsets = {"1": -0.15, "psi": 0.0, "sigma": 0.15}
    fig, ax = plt.subplots(figsize=(5, 7))
    for q in CHARGES:
        xs, ys = [], []
        for (m, charge), values in spectrum.items():
            if charge == q:
                xs.extend([m + offsets[q]] * len(values))
                ys.extend(scale * (np.asarray(values) - E0))
        if xs:
            ax.scatter(xs, ys, color=_COLORS[q], marker="x", zorder=3, label=_LABELS[q])
    if ymax is not None:
        ax.set_ylim(-0.02 * ymax, ymax)
    ax.xaxis.set_major_locator(MaxNLocator(integer=True))
    ax.set_xlabel(r"Momentum $m$ ($k=2\pi m/L$)")
    ax.set_ylabel(ylabel)
    ax.set_title(title or f"L={L}")
    ax.grid(True, linestyle="--", alpha=0.6)
    ax.legend(title=r"$(\lambda_1,\lambda_\psi,\lambda_\sigma)$")
    fig.tight_layout()
    if save is not None:
        fig.savefig(save, dpi=150)
    if show:
        plt.show()
    return fig


def run_simulation(L=12, r=0.0, theta=math.pi / 4, nev=12):
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--L", type=int, default=L)
    parser.add_argument("--r", type=float, default=r)
    parser.add_argument("--theta", type=float, default=theta,
                        help="angle in radians (default pi/4)")
    parser.add_argument("--nev", type=int, default=nev, help="eigenvalues per (m, charge) block")
    parser.add_argument("--charges", nargs="+", choices=CHARGES, default=list(CHARGES))
    parser.add_argument("--momenta", type=int, nargs="+", help="integer m values (default: all)")
    parser.add_argument("--all-momenta", action="store_true",
                        help="diagonalize m > L/2 too instead of copying conj(H_{L-m})")
    parser.add_argument("--block-format", choices=("auto", "explicit", "factored"),
                        default="auto", help="explicit or factored charge-1/psi blocks")
    parser.add_argument("--max-states", type=int, default=300_000_000)
    parser.add_argument("--dense-cutoff", type=int, default=128)
    parser.add_argument("--output", type=Path, help="optional JSON output path")
    parser.add_argument("--validate", action="store_true", help="full small-system checks, L<=10")
    parser.add_argument("--rescale", action="store_true",
                        help="rescale so the lowest (m=2, charge 1) level is 2, as in Fig. 3b")
    parser.add_argument("--ymax", type=float, help="upper y limit of the plot")
    parser.add_argument("--save-plot", type=Path, help="write the figure to this file")
    parser.add_argument("--no-plot", action="store_true")
    args = parser.parse_args()
    r, theta = _parameters(args.r, args.theta)
    if args.validate and hilbert_dimension(args.L) > 8000:
        parser.error("--validate compares with full dense ED; use it with L <= 10")
    start = time.perf_counter()
    basis = SymmetryBasis(args.L, max_states=args.max_states)
    basis.hamiltonian_transitions()
    basis.fold_structure()
    L = basis.L
    print(f"L={L}, dimension={basis.dimension:,}, G-orbits={basis.n_reps:,}, "
          f"r={r:.12g}, theta={theta:.12g}  (setup {time.perf_counter() - start:.2f} s)")
    print("T is right translation; T eigenvalue exp(-ik), k=2*pi*m/L; "
          "charges (lambda_1, lambda_psi, lambda_sigma) as in Eq. (24)")
    result = {"L": L, "r": r, "theta": theta, "dimension": basis.dimension,
              "translation": "right", "translation_eigenvalue": "exp(-i*k)",
              "momentum_formula": "k=2*pi*m/L",
              "charges": {q: list(CHARGE_LAMBDA[q]) for q in args.charges},
              "sectors": []}
    ms = range(L) if args.momenta is None else sorted({basis.momentum(m) for m in args.momenta})
    charges = tuple(args.charges)
    spectrum: dict[tuple[int, str], np.ndarray] = {}
    dims: dict[tuple[int, str], int] = {}
    for m in ms:
        partner = (L - m) % L
        mirrored = (not args.all_momenta and partner < m
                    and all((partner, q) in spectrum for q in charges))
        tick = time.perf_counter()
        if mirrored:
            solved = {q: (spectrum[(partner, q)], None, dims[(partner, q)]) for q in charges}
        else:
            blocks = build_symmetry_blocks(basis, m, r, theta, charges)
            solved = {}
            for q in charges:
                evals, _, res = lowest_eigenpairs(blocks[q], nev=args.nev, return_residuals=True,
                                                  dense_cutoff=args.dense_cutoff,
                                                  block_format=args.block_format)
                solved[q] = (evals, res, blocks[q].shape[0])
        for q in charges:
            evals, res, dim = solved[q]
            spectrum[(m, q)], dims[(m, q)] = evals, dim
            result["sectors"].append({
                "m": m, "k": 2 * math.pi * m / L, "charge": q,
                "lambda": list(CHARGE_LAMBDA[q]), "dimension": int(dim),
                "eigenvalues": np.asarray(evals).tolist(),
                "residual_norms": None if res is None else np.asarray(res).tolist(),
                "copied_from_m": partner if mirrored else None})
            printed = " ".join(f"{e:.12f}" for e in evals)
            print(f"m={m:2d}  {q:>5s}  dim={dim:8d}  E: {printed}")
        if not mirrored:
            print(f"      (m={m} solved in {time.perf_counter() - tick:.2f} s)")
    print(f"Total time {time.perf_counter() - start:.2f} s")
    if args.validate:
        result["validation"] = validate_model(basis, r, theta)
        print(f"Validation passed; maximum absolute discrepancy "
              f"{result['validation']['max_error']:.3e}")
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
        print(f"Wrote {args.output}")
    if not args.no_plot or args.save_plot:
        plot_spectrum(spectrum, L, rescale=args.rescale, ymax=args.ymax,
                      title=rf"$L={L}$, $(r,\theta)=({r:.3g},{theta:.3g})$",
                      save=args.save_plot, show=not args.no_plot)
    return result


if __name__ == "__main__":
    for r in range(-30, 31, 5):
        run_simulation(L=3, r=r, theta=math.pi / 4, nev=4)
