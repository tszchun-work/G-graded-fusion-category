# Eigensolver
# =============================================================================

def _max_abs(matrix) -> float:
    if issparse(matrix):
        matrix = matrix.tocsr()
        return float(np.max(np.abs(matrix.data))) if matrix.nnz else 0.0
    array = np.asarray(matrix)
    return float(np.max(np.abs(array))) if array.size else 0.0


def _check_hermitian(H) -> None:
    error = _max_abs(H - H.getH())
    if error > 1e-10 * max(1.0, _max_abs(H)):
        raise ValueError(f"H is not Hermitian (maximum discrepancy {error:.3g})")


def _check_block_hermitian(block: SectorBlock, seed: int) -> None:
    _check_hermitian(block.H)
    if not block.folded or block.H_BA.nnz == 0:
        return
    # randomized test of the coupling C = S_AB H_BA, which is never formed here
    rng = np.random.default_rng(seed)
    n = block.H.shape[0]
    x = rng.normal(size=n) + (1j * rng.normal(size=n) if block.dtype == np.complex128 else 0)
    y = rng.normal(size=n) + (1j * rng.normal(size=n) if block.dtype == np.complex128 else 0)
    cy = block.coupling(y)
    cx = block.coupling(x)
    error = abs(np.vdot(x, cy) - np.vdot(cx, y))
    scale = np.linalg.norm(x) * np.linalg.norm(cy) + np.linalg.norm(cx) * np.linalg.norm(y)
    if error > 1e-10 * max(1.0, scale):
        raise ValueError(f"Fold coupling is not Hermitian (discrepancy {error:.3g})")


def lowest_eigenpairs(H, nev: int = 5, *, return_residuals: bool = False,
                      tol: float = 1e-11, maxiter: int | None = None,
                      seed: int = 1729, dense_cutoff: int = 128,
                      max_dense_dimension: int = 4096, block_format: str = "auto"):
    """Return SORTED lowest (eigenvalues, eigenvectors[, residual_norms]).

    H may be a SectorBlock or any sparse/dense Hermitian matrix. Complex scipy
    eigsh delegates to eigs, which cannot use k >= N-1, so that range falls back
    to dense eigh. A deterministic random start avoids confining Lanczos to a
    residual-symmetry subspace. Degeneracies should still be checked densely for
    small N.
    """
    nev = _integer(nev, "nev")
    if nev < 1:
        raise ValueError("nev must be positive")
    dense_cutoff = _integer(dense_cutoff, "dense_cutoff")
    if dense_cutoff < 0:
        raise ValueError("dense_cutoff must be nonnegative")
    max_dense_dimension = _integer(max_dense_dimension, "max_dense_dimension")
    if max_dense_dimension < 1:
        raise ValueError("max_dense_dimension must be positive")
    if not isinstance(tol, Real) or not math.isfinite(tol) or tol < 0:
        raise ValueError("tol must be finite and nonnegative")
    if maxiter is not None and _integer(maxiter, "maxiter") < 1:
        raise ValueError("maxiter must be positive or None")
    seed = _integer(seed, "seed")
    if isinstance(H, SectorBlock):
        block = H
        _check_block_hermitian(block, seed)
        apply = block.matvec
    else:
        block = None
        H = csr_matrix(H)
        if H.shape[0] != H.shape[1]:
            raise ValueError("H must be square")
        if np.any(~np.isfinite(H.data)):
            raise ValueError("H contains nonfinite matrix elements")
        _check_hermitian(H)
        apply = H.__matmul__
    n = H.shape[0]
    count = min(nev, n)
    if n == 0:
        evals = np.empty(0)
        evecs = np.empty((0, 0), dtype=H.dtype)
    elif n <= dense_cutoff or count >= n - 1:
        if n > max_dense_dimension:
            raise MemoryError(
                f"Dense diagonalization of dimension {n} exceeds the guard "
                f"{max_dense_dimension}; request fewer eigenvalues or explicitly "
                "raise max_dense_dimension with sufficient memory.")
        dense = block.to_dense() if block is not None else H.toarray()
        evals, evecs = np.linalg.eigh(dense)
        evals, evecs = evals[:count], evecs[:, :count]
    else:
        operator = block.operator(block_format) if block is not None else H
        rng = np.random.default_rng(seed)
        v0 = rng.normal(size=n)
        if np.issubdtype(H.dtype, np.complexfloating):
            v0 = v0 + 1j * rng.normal(size=n)
        v0 /= np.linalg.norm(v0)
        ncv = min(n, max(2 * count + 1, 32))
        evals, evecs = eigsh(operator, k=count, which="SA", v0=v0, tol=tol,
                             maxiter=maxiter, ncv=ncv)
        order = np.argsort(evals)
        evals, evecs = evals[order], evecs[:, order]
    if return_residuals:
        residuals = (np.linalg.norm(apply(evecs) - evecs * evals[None, :], axis=0)
                     if n else np.empty(0))
        return evals, evecs, residuals
    return evals, evecs


def solve_spectrum(basis: SymmetryBasis | int, r: float, theta: float, nev: int = 5, *,
                   momenta=None, charges=CHARGES, mirror: bool = True,
                   **eig_kwargs) -> dict[tuple[int, str], np.ndarray]:
    """Return {(m, charge): sorted lowest eigenvalues}, k = 2*pi*m/L.

    With mirror=True a sector m > L/2 whose partner L-m was already solved is
    copied (H real => H_{L-m} = conj(H_m)). Pass a SymmetryBasis to reuse the
    enumeration and operator structure across a parameter scan.
    """
    if isinstance(basis, Integral):
        basis = SymmetryBasis(basis)
    charges = tuple(_charge(q) for q in charges)
    L = basis.L
    ms = range(L) if momenta is None else sorted({basis.momentum(m) for m in momenta})
    result: dict[tuple[int, str], np.ndarray] = {}
    for m in ms:
        partner = (L - m) % L
        if mirror and partner < m and all((partner, q) in result for q in charges):
            for q in charges:
                result[(m, q)] = result[(partner, q)].copy()
            continue
        blocks = build_symmetry_blocks(basis, m, r, theta, charges)
        for q in charges:
            result[(m, q)] = lowest_eigenpairs(blocks[q], nev=nev, **eig_kwargs)[0]
    return result


# =============================================================================
# Validation against the explicit reference implementation (small L)
# =============================================================================

def _symmetric_ket(basis: SymmetryBasis, reference: FullBasis, rep: int, m: int,
                   parity: int) -> np.ndarray:
    """|a;k,p> in the full basis, by an explicit sum over G (independent of `locate`)."""
    L = basis.L
    k = 2.0 * math.pi * m / L
    state = basis.rep_state(rep)
    vector = np.zeros(len(reference), dtype=np.complex128)
    for f in (0, 1):
        flipped = _psi_flip(state) if f else state
        for t in range(L):
            vector[reference.state_to_index[translate(flipped, t)]] += np.exp(1j * k * t) * parity ** f
    norm = np.linalg.norm(vector)
    if norm < 1e-8:
        raise AssertionError("A representative is incompatible with its sector")
    return vector / norm


def explicit_isometry(basis: SymmetryBasis, reference: FullBasis, block: SectorBlock,
                      usigma: csr_matrix) -> np.ndarray:
    """Columns of the block's basis in the full basis (uses the REFERENCE U(sigma)).

    Q^dagger H Q must reproduce block.to_dense(); this checks the vectorized
    S_AB and E eigenvectors against Eq. (20) as implemented in symmetry_action.
    """
    if block.charge == "sigma":
        columns = [_symmetric_ket(basis, reference, a, block.m, -1) for a in block.reps]
        return np.array(columns).T.reshape(len(reference), len(columns))
    QA = np.array([_symmetric_ket(basis, reference, a, block.m, 1) for a in block.reps])
    QA = QA.T.reshape(len(reference), len(block.reps))
    Q = (QA + block.sign * (usigma @ QA) / _SQRT2) / _SQRT2
    if block.e_reps.size:
        QE = np.array([_symmetric_ket(basis, reference, e, block.m, 1) for e in block.e_reps]).T
        Q = np.hstack([Q, QE @ block.U_E.toarray()])
    return Q


def validate_model(basis: SymmetryBasis | int, r: float, theta: float,
                   tolerance: float = 1e-9, max_dimension: int = 8000) -> dict:
    """Small-system structural validation, including the full categorical symmetry.

    Checks the symmetry algebra (22) on the reference operators; for every
    (m, charge) block: isometry, Q^dag H Q = block, T = e^{-ik}, U(psi) and
    U(sigma) eigenvalues from Eq. (24), Hermiticity and the m <-> L-m conjugation;
    and that the union of all block spectra equals full ED.
    """
    if isinstance(basis, Integral):
        basis = SymmetryBasis(basis)
    if basis.dimension > max_dimension:
        raise ValueError("Validation uses full dense ED; use L <= 10 for this check")
    L = basis.L
    reference = FullBasis(L)
    H = full_hamiltonian(reference, r, theta)
    T = translation_operator(reference)
    ident = eye(len(reference), format="csr")
    upsi = symmetry_operator(reference, "psi")
    usigma = symmetry_operator(reference, "sigma")
    errors = {
        "H_hermiticity": _max_abs(H - H.getH()),
        "translation_commutator": _max_abs(T @ H - H @ T),
        "Upsi_hermiticity": _max_abs(upsi - upsi.getH()),
        "Usigma_hermiticity": _max_abs(usigma - usigma.getH()),
        "Upsi_squared_minus_I": _max_abs(upsi @ upsi - ident),
        "Upsi_Usigma_minus_Usigma": _max_abs(upsi @ usigma - usigma),
        "Usigma_Upsi_minus_Usigma": _max_abs(usigma @ upsi - usigma),
        "Usigma_squared_minus_I_minus_Upsi": _max_abs(usigma @ usigma - ident - upsi),
        "Upsi_H_commutator": _max_abs(upsi @ H - H @ upsi),
        "Usigma_H_commutator": _max_abs(usigma @ H - H @ usigma),
        "Usigma_T_commutator": _max_abs(usigma @ T - T @ usigma),
    }
    all_evals, dims = [], {q: 0 for q in CHARGES}
    dense_blocks, block_evals, n_primary = {}, {}, {}
    for m in range(L):
        k = 2.0 * math.pi * m / L
        blocks = build_symmetry_blocks(basis, m, r, theta)
        for q, block in blocks.items():
            dense = block.to_dense()
            dense_blocks[(m, q)] = dense
            block_evals[(m, q)] = np.linalg.eigvalsh(dense) if dense.size else np.empty(0)
            n_primary[(m, q)] = block.H.shape[0]
            dims[q] += dense.shape[0]
            lam = CHARGE_LAMBDA[q]
            tag = f"m{m}_{q}"
            errors[f"{tag}_H_hermiticity"] = _max_abs(dense - dense.conj().T)
            if dense.shape[0]:
                Q = explicit_isometry(basis, reference, block, usigma)
                errors[f"{tag}_isometry"] = _max_abs(Q.conj().T @ Q - np.eye(Q.shape[1]))
                errors[f"{tag}_projected_H"] = _max_abs(Q.conj().T @ (H @ Q) - dense)
                errors[f"{tag}_translation_eigenvalue"] = _max_abs(T @ Q - np.exp(-1j * k) * Q)
                errors[f"{tag}_Upsi_eigenvalue"] = _max_abs(upsi @ Q - lam[1] * Q)
                errors[f"{tag}_Usigma_eigenvalue"] = _max_abs(usigma @ Q - lam[2] * Q)
                # factored application agrees with the explicit matrix
                x = np.random.default_rng(m).normal(size=dense.shape[0])
                errors[f"{tag}_factored_matvec"] = _max_abs(block.matvec(x) - dense @ x)
                if block.folded and block.S.shape[1]:
                    xb = np.random.default_rng(m + 1).normal(size=block.S.shape[1])
                    errors[f"{tag}_walsh_hadamard_vs_sparse_S"] = _max_abs(
                        block.S.apply(xb) - block.S_AB @ xb)
                all_evals.extend(block_evals[(m, q)])
    for m in range(1, L):
        for q in CHARGES:
            # H real => H_{L-m} = conj(H_m) on A (the E eigenvector basis is arbitrary)
            nA = n_primary[(m, q)]
            errors[f"m{m}_{q}_A_block_conjugate_of_m{L - m}"] = _max_abs(
                dense_blocks[(m, q)][:nA, :nA] - dense_blocks[(L - m, q)][:nA, :nA].conj())
            errors[f"m{m}_{q}_spectrum_equals_m{L - m}"] = _max_abs(
                block_evals[(m, q)] - block_evals[(L - m, q)])
    D = len(reference)
    expected = {"1": (D + 1) // 4, "psi": (D + 1) // 4, "sigma": (D - 1) // 2}
    if dims != expected or sum(dims.values()) != D:
        raise AssertionError(f"Charge-sector dimensions {dims} differ from {expected}")
    errors["full_vs_block_spectrum"] = _max_abs(
        np.sort(all_evals) - np.linalg.eigvalsh(H.toarray()))
    failed = {key: value for key, value in errors.items() if value > tolerance}
    if failed:
        raise AssertionError(f"Validation failed (absolute tolerance {tolerance}): {failed}")
    return {"passed": True, "dimension": D, "charge_dimensions": dims,
            "max_error": max(errors.values()), "errors": errors}


